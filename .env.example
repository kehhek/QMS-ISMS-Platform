# Copy to .env and fill in real values for anything beyond local dev.
# docker-compose.yml now requires a real .env to exist alongside it —
# DJANGO_SECRET_KEY/POSTGRES_PASSWORD/REDIS_PASSWORD are read from it
# via ${VAR} substitution rather than hardcoded in the compose file.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret

# Must be False in any real deployment.
DJANGO_DEBUG=True

# Comma-separated. A leading dot matches the bare domain and all subdomains
# (e.g. ".example.com" matches example.com and any-tenant.example.com).
# Only enforced when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=.localhost,localhost,127.0.0.1

# Comma-separated origins allowed to make cross-origin requests to the API.
# Only enforced when DJANGO_DEBUG=False.
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=multi_tenant_db
POSTGRES_USER=postgres
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# — used both to init a brand-new `db` volume AND by the `web`/`celery`/
# `celery-beat` services to connect to it. If you're rotating this
# against an ALREADY-initialized volume (Postgres only applies
# POSTGRES_PASSWORD on first init), you must also run
# `ALTER USER postgres WITH PASSWORD '...'` against the running db
# container yourself — editing this alone won't change a live password.
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis had no authentication at all before this — generate one the same
# way as POSTGRES_PASSWORD above.
REDIS_PASSWORD=change-me-generate-a-real-secret

CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:6379/0
